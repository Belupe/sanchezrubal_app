<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Red saliente: Supabase (Auth/DB/Realtime/Functions) y media a MinIO. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Adjuntar imágenes/vídeos (image_picker). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- SIN entitlement de push a propósito. En macOS un `aps-environment` de
	     desarrollo obliga a firmar con certificado y perfil de DESARROLLO, y
	     ese perfil exige tener Macs registrados como dispositivos en la cuenta
	     de Apple. Al no haberlos, añadirlo aquí rompía `flutter build macos` y
	     `flutter run -d macos`, que hoy se firman adhoc sin pedir nada.
	     El push va solo en Release (ver Release.entitlements), que firma con
	     certificado de distribución y no necesita dispositivos registrados.
	     Consecuencia: el push de macOS no se puede probar en una compilación de
	     depuración; hay que probarlo en una build de Release / TestFlight. -->
</dict>
</plist>
