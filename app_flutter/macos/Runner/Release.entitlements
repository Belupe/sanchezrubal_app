<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Red saliente: imprescindible para Supabase (Auth/DB/Realtime/Functions)
	     y para subir/descargar media a MinIO. Sin esto la app no conecta. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Adjuntar imágenes/vídeos (image_picker). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Push (APNs). La clave de macOS es `com.apple.developer.aps-environment`,
	     no la `aps-environment` de iOS. Aquí va `production` porque este fichero
	     solo se usa en Release, que es lo que se archiva para la Mac App Store;
	     el valor definitivo lo impone de todos modos el perfil de aprovisiona-
	     miento con el que Xcode firma al exportar. -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
</dict>
</plist>
