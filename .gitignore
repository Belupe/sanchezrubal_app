node_modules/
.env
.env.local
env

# Backend de Supabase: se gestiona en local y por el Dashboard, no se publica.
# Migraciones, Edge Functions, config y tests viven fuera del repo público.
supabase/
scripts/push-supabase-secrets.sh
scripts/push-supabase-secrets.ps1

# Config local de Claude Code (no compartir)
.claude/settings.local.json

# IDE — IntelliJ/Android Studio (config local, no compartir)
.idea/

# Firma de Android (NUNCA subir el keystore ni sus contraseñas)
key.properties
*.jks
*.keystore

# Firebase / FCM — la SERVICE ACCOUNT no se sube JAMÁS: contiene una clave
# privada que permite enviar push a todos los dispositivos. El patrón de
# adminsdk está porque Firebase descarga el fichero con ESE nombre, que no
# encaja con "service-account" y se colaría sin darte cuenta.
*service-account*.json
*adminsdk*.json
fcm-service-account.json

# GoogleService-Info.plist (iOS) SÍ está en el repositorio, a propósito: no
# contiene secretos —solo API key de cliente, sender ID y project ID, que son
# identificadores públicos— y cualquiera puede extraerlo del .ipa publicado.
# Xcode Cloud lo necesita en el clon, porque el proyecto lo referencia.

# Artefactos finales (se regeneran con scripts/release.ps1)
dist/
build/
.next/
.DS_Store
*.log
uploads/
logs/
logs_data/
sqlite_data/
uploads_data/
