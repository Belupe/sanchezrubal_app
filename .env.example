# =====================================================================
#  .env.example  —  Portal Familia
# =====================================================================

# ---------------------------------------------------------------------
#  1) SUPABASE
# ---------------------------------------------------------------------
# 1a) PUBLICAS - se hornean en las apps (la anon key es publica; la protege el RLS).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 1b) Referencia del proyecto (subdominio de SUPABASE_URL).
SUPABASE_PROJECT_REF=

# 1c) ACCESS TOKEN de la CLI, para desplegar sin 'supabase login'.
#     https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# 1d) SERVICE ROLE KEY. Solo si la usas en scripts externos: Supabase la
#     inyecta sola en las Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# 1e) Contraseña de la BD. Solo si haces 'supabase db push/pull'.
SUPABASE_DB_PASSWORD=


# ---------------------------------------------------------------------
#  RED
# ---------------------------------------------------------------------
BIND_HOST=127.0.0.1

# ---- Imagenes ----
# Vacio = se usa el :latest del compose. Para fijar por digest:
#   docker inspect --format='{{index .RepoDigests 0}}' minio/minio:latest
MINIO_IMAGE=
MC_IMAGE=
NGINX_IMAGE=

# Worker media-scrub: la publica GitHub Actions en GHCR y el servidor solo la
# descarga. El paquete debe estar PUBLICO en la pestaña Packages del repo.
MEDIA_SCRUB_IMAGE=ghcr.io/belupe/media-scrub:latest

# Usuario/grupo no-root de minio y createbuckets. En Linux las carpetas de
# datos deben pertenecer a este UID/GID:  sudo chown -R 1000:1000 <carpeta>
MINIO_UID=1000
MINIO_GID=1000

# Topes de memoria/CPU por contenedor.
MINIO_MEM_LIMIT=1g
MINIO_CPU_LIMIT=1.0
MC_MEM_LIMIT=128m
UPDATES_MEM_LIMIT=128m
UPDATES_CPU_LIMIT=0.5
MEDIA_SCRUB_MEM_LIMIT=512m
MEDIA_SCRUB_CPU_LIMIT=1.0


# ---------------------------------------------------------------------
#  2) ALMACENAMIENTO
# ---------------------------------------------------------------------
# Rutas ABSOLUTAS del host. Las carpetas deben EXISTIR antes del 'up' o
# Docker falla al montarlas. En Windows usa barras normales (C:/...).

# Fotos y video (los sirve MinIO).
MEDIA_DATA_DIR=/home/USUARIO/sr/minio/media

# Instaladores de Windows/Linux + version.json.
UPDATES_DATA_DIR=/home/USUARIO/sr/updates

# Config de nginx del servicio updates. Vacio = se usa la del repositorio
# (./server/nginx/updates.conf), que es lo normal con 'docker compose up'.
# Con Dockge conviene ponerla FUERA de la carpeta del stack, que gestiona el
# panel, apuntando a una ruta absoluta propia:
#   UPDATES_NGINX_CONF=/home/USUARIO/sr/server/nginx/updates.conf
# El fichero se saca del repositorio:
#   curl -fsSL -o <ruta> https://raw.githubusercontent.com/Belupe/sanchezrubal_app/main/server/nginx/updates.conf
UPDATES_NGINX_CONF=


# ---------------------------------------------------------------------
#  3) MEDIA (MinIO)
# ---------------------------------------------------------------------
# Credenciales root. El usuario NO debe ser adivinable: es la mitad de la
# credencial de administrador.  openssl rand -hex 8  /  openssl rand -base64 24
MINIO_ROOT_USER=pon_aqui_un_usuario_admin_no_obvio
MINIO_ROOT_PASSWORD=pon_aqui_una_contrasena_larga_y_aleatoria

# URL del API S3. MinIO firma las URLs con este host: tiene que ser EXACTAMENTE
# el hostname del tunel, con https y sin barra final, o las firmas se rechazan
# y la app no ve las fotos. Es el fallo mas comun de este despliegue.
MEDIA_PUBLIC_URL=

# Access key DEDICADA de la Edge Function media-sign, con permiso Get/Put SOLO
# sobre el bucket (no la root). Hay que crearla en la consola de MinIO con esta
# misma pareja de valores. Ver docs/SEGURIDAD.md.
MEDIA_SIGN_ACCESS_KEY=media-sign
MEDIA_SIGN_SECRET_KEY=pon_aqui_un_secret_largo_y_aleatorio

# ---- por defecto ----
MEDIA_BUCKET=inspections
MINIO_REGION=us-east-1
MEDIA_MAX_UPLOAD_BYTES=104857600
MINIO_CORS_ORIGIN=*
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_URL=


# ---------------------------------------------------------------------
#  4) ACTUALIZACIONES
# ---------------------------------------------------------------------
# Las apps consultan ${UPDATES_PUBLIC_URL}/<plataforma>/version.json
UPDATES_PUBLIC_URL=
UPDATES_PORT=8090

# ---- Enlaces de la pagina de descargas ----
# Vacio = ese boton no aparece en la pagina.
DOWNLOAD_ANDROID_PLAY_URL=
DOWNLOAD_WINDOWS_URL=./windows/portal-familia-setup.exe
DOWNLOAD_LINUX_APPIMAGE_URL=./linux/portal-familia-x86_64.AppImage
DOWNLOAD_LINUX_DEB_URL=./linux/portal-familia_amd64.deb
DOWNLOAD_IOS_URL=
# App Store (no listado). Mismo id que iOS: la ficha de Mac es la misma app.
DOWNLOAD_MACOS_URL=


# ---------------------------------------------------------------------
#  5) DISPARADORES INTERNOS (cron + cola de reservas)
# ---------------------------------------------------------------------
# Token con el que el backend se llama a si mismo (send-email, notify-waitlist).
# DEBE COINCIDIR con el secreto 'cron_secret' del Vault de Supabase:
#   select decrypted_secret from vault.decrypted_secrets where name='cron_secret';
# Si no coincide, la cola y los recordatorios fallan en silencio.
CRON_SECRET=pon_aqui_un_token_aleatorio

# '*' es inofensivo aqui: la app es nativa y no depende de CORS.
FUNCTIONS_ALLOWED_ORIGIN=*


# ---------------------------------------------------------------------
#  6) NOTIFICACIONES PUSH (Firebase)
# ---------------------------------------------------------------------
# Secreto DEDICADO para invocar send-push, distinto del CRON_SECRET: si uno se
# filtra, con el otro no se pueden mandar push a usuarios arbitrarios.
PUSH_SECRET=pon_aqui_otro_token_aleatorio_distinto_del_cron

# Ruta al JSON de la service account de Firebase. Este fichero NO va en el
# servidor: ningun contenedor lo usa. Lo lee push-supabase-secrets.*, que sube
# su CONTENIDO a Supabase, asi que la ruta es la de TU maquina, no la del
# servidor. Dejalo vacio si aun no usas push.
#   console.firebase.google.com -> Configuracion del proyecto -> Cuentas de
#   servicio -> Generar nueva clave privada
FCM_SERVICE_ACCOUNT_FILE=


# ---------------------------------------------------------------------
#  7) SUPABASE AUTOALOJADO  (server/supabase-sr)
# ---------------------------------------------------------------------
# Este bloque NO lo lee el compose.yaml de arriba: va en el .env del STACK de
# Supabase (la carpeta del compose oficial self-hosted, donde se copia
# server/supabase-sr/docker-compose.sr.yml). Ese .env lo genera el setup.sh
# oficial con sus propios secretos (JWT, Postgres, claves de API); aqui solo
# esta lo que se le añade o se le cambia.

# Solo en el .env del stack; aqui cambiarian el proyecto de compose.yaml:
#   COMPOSE_PROJECT_NAME=supabase-sr
#   COMPOSE_FILE=docker-compose.yml:docker-compose.sr.yml

# URL publica de la instancia: la que hornean las apps como SUPABASE_URL.
SUPABASE_PUBLIC_URL=
# = SUPABASE_PUBLIC_URL + /auth/v1
API_EXTERNAL_URL=
SITE_URL=
# Esquema de la app: es a donde vuelven los enlaces de invitacion y de
# recuperacion de contraseña.
ADDITIONAL_REDIRECT_URLS=portalfamilia://**

# IP de la maquina (nunca localhost ni 0.0.0.0) y un puerto libre para cada uno.
# Pasarela: API + Studio con usuario/contraseña. Solo red local.
API_GW_HTTP_PORT=192.168.1.10:8430
# oauth2-proxy delante del Studio: lo unico del panel que sale por el tunel.
STUDIO_SSO_PORT=192.168.1.10:8431

# Auth: alta solo por invitacion.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false

# Correo de Auth (invitaciones y recuperacion). Los avisos de la app no pasan
# por aqui: los manda send-email con el SMTP de system_config.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Portal Familia

# El enrutador de funciones verifica el JWT salvo en las de FUNCTIONS_PUBLIC,
# que se protegen con su propio secreto o son publicas a proposito.
FUNCTIONS_VERIFY_JWT=true
FUNCTIONS_PUBLIC=send-email,send-push,notify-changes,health

# SSO del Studio (cliente OIDC confidencial con PKCE; redirect
# <SUPABASE_PUBLIC_URL>/oauth2/callback). Cookie:  openssl rand -base64 32 | tr -- '+/' '-_'
STUDIO_SSO_PROVIDER_NAME=
STUDIO_SSO_ISSUER_URL=
STUDIO_SSO_CLIENT_ID=
STUDIO_SSO_CLIENT_SECRET=
STUDIO_SSO_COOKIE_SECRET=
STUDIO_SSO_ALLOWED_GROUPS=

# Secretos de las Edge Functions. En la nube los subia push-supabase-secrets;
# aqui se copian TAL CUAL de las secciones 3, 5 y 6 de este fichero:
#   MEDIA_PUBLIC_URL  MEDIA_BUCKET  MINIO_REGION  MEDIA_MAX_UPLOAD_BYTES
#   MEDIA_SIGN_ACCESS_KEY  MEDIA_SIGN_SECRET_KEY
#   CRON_SECRET  PUSH_SECRET  FUNCTIONS_ALLOWED_ORIGIN
# Y el CONTENIDO del JSON de la service account de Firebase, en una linea y
# entre comillas simples:  jq -c . fcm-service-account.json
FCM_SERVICE_ACCOUNT=
