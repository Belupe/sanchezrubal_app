# =====================================================================
#  .env  —  ARCHIVO ÚNICO DE CONFIGURACIÓN DE PORTAL FAMILIA
# =====================================================================
#
#  Esta es la ÚNICA fuente de la verdad: aquí van TODAS las credenciales,
#  ubicaciones de almacenamiento y URLs. Lo editas UNA vez y tres
#  "adaptadores" reparten cada cosa a donde va:
#
#    [DOCKER]    compose.yaml lo lee solo (minio + updates).
#    [SUPABASE]  scripts/push-supabase-secrets.*  sube los secrets a las
#                Edge Functions (la nube NO lee este archivo en runtime).
#    [APP]       scripts/build-*.ps1  hornean SOLO los valores PÚBLICOS en
#                la app (NUNCA los secretos).
#
#  CÓMO USARLO:
#    1) cp .env.example .env       (el .env real es el que leen los scripts)
#    2) Rellena las líneas marcadas con ⬅️ CAMBIA
#    3) docker compose up -d                         (media + updates)
#       ./scripts/push-supabase-secrets.ps1|.sh      (secrets de Supabase)
#       ./scripts/release.ps1 -Bump                   (compila y publica apps)
#
#  ⚠️  El archivo .env NUNCA se sube al repositorio (.gitignore).
# =====================================================================


# ---------------------------------------------------------------------
#  1) SUPABASE  —  TODA la configuración de Supabase vive aquí
# ---------------------------------------------------------------------
# ⚠️ En las Edge Functions, SUPABASE_URL, SUPABASE_ANON_KEY y
#    SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase POR SÍ MISMO en runtime
#    (el prefijo SUPABASE_ está reservado: no se pueden subir como secrets ni
#    hace falta). Por eso, lo que hay aquí sirve para:
#      · hornear las públicas en las apps (build),
#      · y operar el proyecto desde la CLI (deploy de functions, secrets,
#        migraciones) usando el token + project-ref de abajo.
#    No tienes que "introducir" nada dentro de los ficheros de supabase/.

# 1a) PÚBLICAS — se hornean en las apps (anon key es público; lo protege el RLS). [APP]
SUPABASE_URL=https://pjceyplciujtrnxptwbx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_3pBEywFkB05ysg4MB_AeJw_JU7InPa7

# 1b) Referencia del proyecto (subdominio de SUPABASE_URL). La usan la CLI y
#     scripts/push-supabase-secrets para apuntar al proyecto SIN 'supabase link'.
SUPABASE_PROJECT_REF=pjceyplciujtrnxptwbx

# 1c) ACCESS TOKEN de la CLI (SECRETO).  ⬅️ CAMBIA para automatizar deploys
#     Créalo en  https://supabase.com/dashboard/account/tokens
#     Permite a la CLI (deploy functions, secrets set, db push) SIN 'supabase login'.
SUPABASE_ACCESS_TOKEN=

# 1d) SERVICE ROLE KEY (SECRETO máximo: salta el RLS).  ⬅️ CAMBIA si la usas
#     Supabase la inyecta sola en las Edge Functions → NO hace falta para que
#     funcionen. Ponla solo si la usas en scripts externos (p. ej. el cutover).
SUPABASE_SERVICE_ROLE_KEY=

# 1e) Contraseña de la BD (SECRETO).  ⬅️ CAMBIA si haces 'supabase db push/pull'
#     La pusiste al crear el proyecto (Dashboard → Settings → Database).
SUPABASE_DB_PASSWORD=

# NOTA — Secrets que SÍ usan las Edge Functions y los sube push-supabase-secrets.*:
#   (Los secrets de Supabase son a NIVEL DE PROYECTO: los comparten todas las
#    funciones, así que CRON_SECRET y FCM_SERVICE_ACCOUNT valen para todas.)
#   media-sign:      MINIO_ENDPOINT  ← MEDIA_PUBLIC_URL
#                    MINIO_BUCKET    ← MEDIA_BUCKET
#                    MINIO_ACCESS_KEY← MINIO_ROOT_USER
#                    MINIO_SECRET_KEY← MINIO_ROOT_PASSWORD
#                    MINIO_REGION    ← MINIO_REGION
#   send-email:      CRON_SECRET     ← CRON_SECRET
#   notify-waitlist: CRON_SECRET     ← CRON_SECRET
#   send-push:       CRON_SECRET     ← CRON_SECRET
#                    FCM_SERVICE_ACCOUNT ← contenido de FCM_SERVICE_ACCOUNT_FILE (sección 6)
# (Es decir: no los repites; salen de las variables de las secciones de abajo.)


# ---------------------------------------------------------------------
#  RED — IP local a la que se publican los puertos de Docker   [DOCKER]
# ---------------------------------------------------------------------
# Interfaz/IP del HOST donde Docker expone MinIO y updates. Cambia las IPs
# locales de TODOS los servicios desde aquí (un solo sitio).
#   • 127.0.0.1  → solo accesible desde la propia máquina (por defecto; lo
#                  normal si delante va el túnel cloudflared en el mismo host).
#   • 192.168.x.y → la IP LAN del servidor, para acceder desde otros equipos
#                  de la red local.
#   • 0.0.0.0    → todas las interfaces (¡expón solo si hay firewall delante!).
BIND_HOST=127.0.0.1


# ---------------------------------------------------------------------
#  2) ALMACENAMIENTO — UBICACIONES EN TU DISCO
# ---------------------------------------------------------------------
# Formato de RUTA según dónde corra Docker:
#   • Windows (Docker Desktop): usa BARRAS NORMALES y SIN espacios,
#       p. ej.  C:/PortalFamilia/media     (evita OneDrive: sincroniza GBs)
#   • Linux/NAS:                /srv/portal-familia/media
# La carpeta debe EXISTIR; si no, Docker fallará al montarla.

# 2a) MEDIA (fotos y vídeo) — la sirve MinIO.   [DOCKER] [SUPABASE] [APP]
# [OBLIGATORIO] ⬅️ CAMBIA — ubicación EXACTA de TODAS las fotos/vídeos.
MEDIA_DATA_DIR=C:/PortalFamilia/media

# 2b) ACTUALIZACIONES (instaladores Android/Windows + version.json).  [DOCKER]
# [OBLIGATORIO] ⬅️ CAMBIA — carpeta que sirve el contenedor `updates`
# (release.ps1 crea dentro android/ y windows/).
UPDATES_DATA_DIR=C:/PortalFamilia/updates


# ---------------------------------------------------------------------
#  3) MEDIA (MinIO) — credenciales y URL pública   [DOCKER] [SUPABASE] [APP]
# ---------------------------------------------------------------------
# [OBLIGATORIO] ⬅️ CAMBIA — contraseña del admin (consola) de MinIO. Genera una
# fuerte:  openssl rand -base64 24   (media-sign ya NO usa esta credencial; usa
# MEDIA_SIGN_ACCESS_KEY / MEDIA_SIGN_SECRET_KEY de abajo). [A-02]
MINIO_ROOT_PASSWORD=pon_aqui_una_contrasena_larga_y_aleatoria

# [OBLIGATORIO] ⬅️ CAMBIA — URL pública del API S3 de la media (subdominio del
# túnel). La usan MinIO (firmas), las apps y la Edge Function (MINIO_ENDPOINT).
MEDIA_PUBLIC_URL=https://media.sanchezrubal.net

# [OBLIGATORIO] ⬅️ CAMBIA — access key DEDICADA de mínimo privilegio que usa la
# Edge Function media-sign para firmar las URLs de fotos (permiso Get/Put SOLO
# sobre el bucket, NO la root). Créala en MinIO con la policy Get/Put del bucket
# (ver docs/SEGURIDAD.md). Sustituye a la reutilización de MINIO_ROOT_USER. [A-02]
MEDIA_SIGN_ACCESS_KEY=media-sign
# [OBLIGATORIO] ⬅️ CAMBIA — secret de la access key anterior (secreto: no lo
# reutilices ni lo subas). Genera uno fuerte:  openssl rand -base64 24
MEDIA_SIGN_SECRET_KEY=pon_aqui_un_secret_largo_y_aleatorio

# ---- normalmente por defecto ----
MINIO_ROOT_USER=portalfamilia          # admin de MinIO (consola); media-sign ya NO lo usa
MEDIA_BUCKET=inspections               # = MINIO_BUCKET de media-sign
MINIO_REGION=us-east-1                 # = MINIO_REGION de media-sign
# [M-02] Tope de tamaño por subida de foto/vídeo (bytes). Default 100 MiB. Lo usa
# la Edge Function media-sign; el límite duro real lo pone también el túnel/MinIO.
MEDIA_MAX_UPLOAD_BYTES=104857600
MINIO_CORS_ORIGIN=*                    # solo relevante si un cliente web sube media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_URL=https://media-console.sanchezrubal.net


# ---------------------------------------------------------------------
#  4) ACTUALIZACIONES — URL pública y puerto   [DOCKER] [APP]
# ---------------------------------------------------------------------
# [OBLIGATORIO] ⬅️ CAMBIA — URL pública de descarga/auto-update (subdominio del
# túnel). Las apps consultan ${UPDATES_PUBLIC_URL}/<plataforma>/version.json.
UPDATES_PUBLIC_URL=https://app.sanchezrubal.net

# [OK por defecto] Puerto local del servicio que sirve los instaladores.
UPDATES_PORT=8090

# ---- Enlaces de descarga de la página (index.html).  [APP: release.ps1] ----
# release.ps1 los hornea en la página de descargas cada vez que publica, así que
# si un enlace se compromete lo cambias AQUÍ y republicas (no se toca código).

# Android — GOOGLE PLAY (por invitación). Es el ÚNICO canal de Android en la página:
# ya NO se ofrece APK de descarga directa. Pega el enlace de aceptación/opt-in de la
# prueba (interna o cerrada) de Play Console; tiene la forma
# https://play.google.com/apps/internaltest/... o .../store/apps/details?id=...
# Si lo dejas VACÍO, el botón de Android no aparece. Ver docs/GOOGLE.md.
DOWNLOAD_ANDROID_PLAY_URL=

# Windows — instalador propio (no hay tienda). Por defecto ruta relativa (lo sirve
# este mismo servidor).
DOWNLOAD_WINDOWS_URL=./windows/portal-familia-setup.exe

# iOS — App Store privado (NO listado). Pega el enlace de distribución no listada
# que da Apple (App Store Connect → "Request unlisted app distribution"); tiene la
# forma https://apps.apple.com/... Si lo dejas VACÍO, el botón de iPhone/iPad no
# aparece en la página. Ver docs/APPLE.md.
DOWNLOAD_IOS_URL=


# ---------------------------------------------------------------------
#  5) CORREOS / DISPARADORES INTERNOS (cron + cola)  —  secret compartido   [SUPABASE]
# ---------------------------------------------------------------------
# [OBLIGATORIO si usas el cron de recordatorios o la lista de espera] ⬅️ CAMBIA
# Token con el que el backend se llama a sí mismo. Lo usan las Edge Functions
# send-email, notify-waitlist y send-push.
# ⚠️ DEBE COINCIDIR con el secreto `cron_secret` guardado en Supabase Vault (el
#    que el trigger de la cola y el cron usan para invocar las funciones). Léelo:
#      select decrypted_secret from vault.decrypted_secrets where name='cron_secret';
# (El SMTP se rellena desde la app, en system_config, NO aquí.)
CRON_SECRET=pon_aqui_un_token_aleatorio


# ---------------------------------------------------------------------
#  6) NOTIFICACIONES PUSH (Firebase Cloud Messaging)   [SUPABASE]
# ---------------------------------------------------------------------
# La Edge Function send-push envía las notificaciones de dispositivo (cola de
# reservas, etc.) vía FCM HTTP v1. Necesita una SERVICE ACCOUNT de Firebase.
#
# CÓMO OBTENERLA:
#   Firebase Console → Configuración del proyecto → Cuentas de servicio →
#   "Generar nueva clave privada" → descarga el JSON (trae client_email,
#   private_key y project_id; send-push saca el project_id de ahí).
#
# [OBLIGATORIO para push] ⬅️ CAMBIA — RUTA al JSON de la service account.
# Se referencia por ARCHIVO (es multilínea: NO se pega aquí). push-supabase-secrets
# lee su contenido y lo sube como el secret FCM_SERVICE_ACCOUNT. El fichero está
# en .gitignore: NUNCA se sube al repo. Déjalo vacío si aún no usas push.
FCM_SERVICE_ACCOUNT_FILE=C:/PortalFamilia/fcm-service-account.json
